# Copiar este archivo como .env y cambiar lo que haga falta.
# Si no existe el .env se usan estos mismos valores.

# Oracle
DB_USER=biblio
DB_PASSWORD=biblio123
DB_HOST=localhost
DB_PORT=1521
DB_SERVICE=XEPDB1

# MongoDB y Redis
USAR_NOSQL=1
MONGO_URI=mongodb://biblio:biblio123@localhost:27017/?authSource=admin
MONGO_DB=biblioteca
REDIS_URL=redis://localhost:6379/0

# Para usar sqlite sin docker:
# BBDD_CONNECTION=sqlite:///biblio_demo.db
# USAR_NOSQL=0
